// Generated by tools/build-dotfiles.py from design/tokens.json - edit the tokens, not this file.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/aperture-logo.txt",
    "color": {
      "1": "#FF7800",
      "2": "#5CCDF7"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#00AEEF",
      "title": "#FF7800",
      "output": "#D9E3E8"
    },
    "key": {
      "width": 12
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "APERTURE OS",
      "outputColor": "bold_#FF7800"
    },
    {
      "type": "custom",
      "format": "AUTOMATED TESTING FACILITY · TEST CHAMBER 01",
      "outputColor": "#81939E"
    },
    {
      "type": "custom",
      "format": "──────────────────────────────────",
      "outputColor": "#30424E"
    },
    {
      "type": "title",
      "key": "SUBJECT",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "os",
      "key": "SYSTEM",
      "format": "{pretty-name}"
    },
    {
      "type": "kernel",
      "key": "KERNEL",
      "format": "{release}"
    },
    {
      "type": "de",
      "key": "SHELL UI"
    },
    {
      "type": "wm",
      "key": "COMPOSITOR"
    },
    {
      "type": "terminal",
      "key": "TERMINAL"
    },
    {
      "type": "shell",
      "key": "SHELL"
    },
    {
      "type": "custom",
      "format": "──────────────────────────────────",
      "outputColor": "#30424E"
    },
    {
      "type": "cpu",
      "key": "CORE",
      "format": "{name} · {cores-logical} threads"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "MEMORY"
    },
    {
      "type": "disk",
      "key": "STORAGE",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "uptime",
      "key": "UPTIME"
    },
    {
      "type": "custom",
      "format": "──────────────────────────────────",
      "outputColor": "#30424E"
    },
    {
      "type": "custom",
      "format": "● SYSTEM ONLINE   ● PORTAL STANDBY",
      "outputColor": "#4FD18B"
    }
  ]
}
