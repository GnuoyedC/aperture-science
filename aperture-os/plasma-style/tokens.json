{
  "$comment": "Aperture OS design tokens - single source of truth. Edit here, then run tools/build-all.sh. Every component keeps a synced copy as tokens.json so it can be built standalone.",
  "name": "Aperture OS",
  "version": "1.0.0",

  "color": {
    "background":       "#070B0F",
    "surface":          "#0D151C",
    "surfaceElevated":  "#111D25",
    "surfaceHover":     "#16252F",
    "border":           "#30424E",
    "borderStrong":     "#456070",
    "text":             "#D9E3E8",
    "textMuted":        "#81939E",
    "textDisabled":     "#56666F",
    "orange":           "#FF7800",
    "orangeBright":     "#FF9A3D",
    "orangeDim":        "#B35400",
    "blue":             "#00AEEF",
    "blueBright":       "#5CCDF7",
    "blueDim":          "#00739F",
    "success":          "#4FD18B",
    "warning":          "#FFB000",
    "error":            "#FF4545",
    "onAccent":         "#0A0E12"
  },

  "$alphaComment": "Opacity (0..1) of surfaces. 1.0 = opaque. Tinted safety glass, not glassmorphism.",
  "alpha": {
    "panel":     0.82,
    "glass":     0.84,
    "window":    0.86,
    "widget":    0.80,
    "menu":      0.94,
    "tooltip":   0.96,
    "dialog":    0.97,
    "critical":  1.00,
    "terminal":  0.88
  },

  "geometry": {
    "radiusWindow": 3,
    "radiusFrame":  3,
    "radiusControl": 2,
    "borderWidth":  1,
    "accentWidth":  2,
    "panelHeight":  40
  },

  "font": {
    "ui":       "Inter",
    "uiFallback": "Noto Sans",
    "uiSize":   10,
    "display":  "Barlow Semi Condensed",
    "displayFallback": "Inter",
    "mono":     "JetBrains Mono",
    "monoFallback": "IBM Plex Mono",
    "terminal": "FiraCode Nerd Font Mono",
    "terminalSize": 10.5
  },

  "motion": {
    "fast":   120,
    "normal": 220,
    "slow":   600,
    "pulse":  4000,
    "reduceMotion": false
  }
}
