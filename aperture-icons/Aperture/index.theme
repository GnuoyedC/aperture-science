[Icon Theme]
Name=Aperture
Comment=Aperture Science Enrichment Center icons. Unofficial fan work.
Inherits=Adwaita,breeze,hicolor
Example=folder
DisplayDepth=32
DesktopDefault=48
DesktopSizes=16,22,24,32,48,64,96,128,256
ToolbarDefault=22
ToolbarSizes=16,22,24,32,48
